# Discord Bot Authentication Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Maximum number of teams in the competition (default: 28)
MAX_TEAMS=28

# Default budget per team in USD (default: 50.00)
DEFAULT_TEAM_BUDGET=50.00


# Name of the staff/reviewer role (default: "QP Chair")
STAFF_ROLE_NAME=QP Chair

# Name of the category where request channels will be created
TICKETS_CATEGORY_NAME=Hardware Requests

# Name of the category where mentor help channels will be created
MENTOR_CATEGORY_NAME=Help Requests

# SQLite database file path
DB_PATH=data/qp_bot.db

# Optional: Guild ID for fast instant slash command synchronization during testing
# GUILD_ID=123456789012345678

